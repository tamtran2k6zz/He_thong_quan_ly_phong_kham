# =============================================================================
# HỆ THỐNG QUẢN LÝ PHÒNG KHÁM ĐA KHOA THÔNG MINH TÍCH HỢP AI HÀNH CHÍNH
# Comprehensive Environment Configuration Template
# =============================================================================

# --- Backend Application Configuration ---
PROJECT_NAME="Hệ thống Quản lý Phòng khám Đa khoa thông minh tích hợp AI Hành chính"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- Security & JWT Authentication ---
# Secret key for signing JWT tokens (Generate a secure key in production)
SECRET_KEY="c0fc7b6b19a1e0b57e79c23594892c9ff5048d087b7a1f59e9a4f494191d9047"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# --- Database Connection Configuration ---
# Option 1: SQLite (Default zero-config local engine for instant verification & development)
DATABASE_URL="sqlite:///./clinic.db"

# Option 2: PostgreSQL (Production-ready & Docker Compose connection)
# DATABASE_URL="postgresql://clinic_user:clinic_password123@localhost:5432/clinic_db"
# For Docker Compose internal network:
# DATABASE_URL="postgresql://clinic_user:clinic_password123@postgres:5432/clinic_db"

# --- Administrative AI Engine Configuration ---
# AI Provider Options:
# - "mock"   : 100% Deterministic Offline Rule-Based Mock Engine (Zero internet dependency, instant responses)
# - "ollama" : Local LLM via Ollama server (e.g. llama3, qwen, mistral)
# - "gemini" : Google Gemini Cloud API (Gemini 1.5 Flash / Pro)
# - "openai" : OpenAI Cloud API (GPT-4o / GPT-3.5-turbo)
AI_PROVIDER="mock"

# Ollama Settings (When AI_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Cloud AI API Keys (Optional, required only when AI_PROVIDER="gemini" or "openai")
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","*"]

# --- Docker Compose Specific Settings ---
POSTGRES_USER="clinic_user"
POSTGRES_PASSWORD="clinic_password123"
POSTGRES_DB="clinic_db"
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL="admin@phongkham.vn"
PGADMIN_DEFAULT_PASSWORD="admin123"
PGADMIN_PORT=5050

# --- Frontend Client Configuration ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
